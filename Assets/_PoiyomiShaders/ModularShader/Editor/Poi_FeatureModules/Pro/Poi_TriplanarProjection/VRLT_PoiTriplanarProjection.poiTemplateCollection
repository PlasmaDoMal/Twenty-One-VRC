void applyTriplanarProjection(in PoiTriplanarData poiTriplanarData, inout PoiFragData poiFragData, inout PoiFragData poiFragData2, inout PoiFragData poiFragData3, inout PoiMesh poiMesh, inout PoiMesh poiMesh2, inout PoiMesh poiMesh3, inout PoiLight poiLight, in PoiCam poiCam)
{
    if (_TriplanarMode == 0 && !poiTriplanarData.depthAvailable) return;

    float3 posOS = poiMesh.localPos;
    float3 normalWS = poiMesh.objNormal;

    float3 triblend = poiTriplanarData.triblend;
    half4 mask = poiTriplanarData.mask;

    float4 colX = float4(poiFragData.baseColor, poiFragData.alpha);
    float4 colY = float4(poiFragData2.baseColor, poiFragData2.alpha);
    float4 colZ = float4(poiFragData3.baseColor, poiFragData3.alpha);
    float4 col = colX * triblend.x + colY * triblend.y + colZ * triblend.z;

    half3 emission = poiFragData.emission  * triblend.x
                    + poiFragData2.emission * triblend.y
                    + poiFragData3.emission * triblend.z;

    float distFade = poiTriplanarData.distFade;

    col.a *= distFade * mask;

    poiFragData.baseColor = lerp(poiFragData.baseColor, col.rgb, mask);
    poiFragData.alpha = col.a;
    poiFragData.emission = emission * col.a;
    poiLight.finalLightAdd *= col.a;
    poiLight.finalLighting *= col.a;
}

