#T#PoiTriplanarProjectionFunctions
void TriplanarProjectionInit(inout PoiTriplanarData poiTriplanarData, inout PoiFragData poiFragData, inout PoiFragData poiFragData2, inout PoiFragData poiFragData3, inout PoiMesh poiMesh, inout PoiMesh poiMesh2, inout PoiMesh poiMesh3, in PoiCam poiCam)
{
    poiTriplanarData.depthAvailable = DepthTextureExists();
    if (_TriplanarMode == 0 && !poiTriplanarData.depthAvailable) return;

    poiTriplanarData.objWorldPos = unity_ObjectToWorld._m03_m13_m23;
    poiTriplanarData.objScale = float3(
        length(unity_ObjectToWorld._m00_m10_m20),
        length(unity_ObjectToWorld._m01_m11_m21),
        length(unity_ObjectToWorld._m02_m12_m22)
    );
    poiTriplanarData.objScale = lerp(1..xxx, poiTriplanarData.objScale, _TriplanarScaleWithObject);

    float3 posOS;
    float3 posWS;
    float3 normalWS;
    float distFade = 1.0;
    switch ((int)_TriplanarMode)
    {
        default:
        case 0:
        {
            float3 eyeCamPos = getCameraPosition(false);
            float perspectiveDivide = 1.0f / poiCam.clipPos.w;
            float4 direction = float4(poiMesh.worldPos.xyz - eyeCamPos, poiCam.worldDirection.w) * perspectiveDivide;
            float2 screenPos = poiCam.posScreenSpace * perspectiveDivide;
            float rawDepth = SampleScreenDepth(screenPos);
            float sceneEyeDepth = CorrectedLinearEyeDepth(rawDepth, direction.w);
            posWS = direction.xyz * sceneEyeDepth + eyeCamPos;
            posOS = (posWS - poiTriplanarData.objWorldPos) / poiTriplanarData.objScale;
            float dist = length(posOS);
            clip(_TriplanarMaxSize - dist);
            distFade = 1.0 - smoothstep(_TriplanarMaxSize - (_TriplanarEdgeFade.y - _TriplanarEdgeFade.x), _TriplanarMaxSize, dist);
            float camDist = distance(getCameraPosition(true), poiTriplanarData.objWorldPos);
            float camFade = 1.0 - saturate((camDist - _TriplanarCameraFade.x) / max(_TriplanarCameraFade.y - _TriplanarCameraFade.x, 1e-5));
            clip(camFade - 1e-6);
            distFade *= camFade;

            float2 depthTexel = _TriplanarDepthBlur / _ScreenParams.xy;
            float3 rayDX = ddx(direction.xyz);
            float3 rayDY = ddy(direction.xyz);
            float corrDX = ddx(direction.w) * _TriplanarDepthBlur;
            float corrDY = ddy(direction.w) * _TriplanarDepthBlur;

            float edgeTol = sceneEyeDepth * 0.1;
            float eyeR = CorrectedLinearEyeDepth(SampleScreenDepth(screenPos + float2(depthTexel.x, 0)), direction.w + corrDX);
            float eyeL = CorrectedLinearEyeDepth(SampleScreenDepth(screenPos - float2(depthTexel.x, 0)), direction.w - corrDX);
            float eyeU = CorrectedLinearEyeDepth(SampleScreenDepth(screenPos + float2(0, depthTexel.y)), direction.w + corrDY);
            float eyeD = CorrectedLinearEyeDepth(SampleScreenDepth(screenPos - float2(0, depthTexel.y)), direction.w - corrDY);

            // Reject taps if too far to avoid artifacts
            eyeR = abs(eyeR - sceneEyeDepth) < edgeTol ? eyeR : sceneEyeDepth;
            eyeL = abs(eyeL - sceneEyeDepth) < edgeTol ? eyeL : sceneEyeDepth;
            eyeU = abs(eyeU - sceneEyeDepth) < edgeTol ? eyeU : sceneEyeDepth;
            eyeD = abs(eyeD - sceneEyeDepth) < edgeTol ? eyeD : sceneEyeDepth;

            float3 posR = (direction.xyz + rayDX * _TriplanarDepthBlur) * eyeR + eyeCamPos;
            float3 posL = (direction.xyz - rayDX * _TriplanarDepthBlur) * eyeL + eyeCamPos;
            float3 posU = (direction.xyz + rayDY * _TriplanarDepthBlur) * eyeU + eyeCamPos;
            float3 posD = (direction.xyz - rayDY * _TriplanarDepthBlur) * eyeD + eyeCamPos;

            float3 dpdx = (abs(eyeR - sceneEyeDepth) < abs(sceneEyeDepth - eyeL)) ? (posR - posWS) : (posWS - posL);
            float3 dpdy = (abs(eyeU - sceneEyeDepth) < abs(sceneEyeDepth - eyeD)) ? (posU - posWS) : (posWS - posD);

            normalWS = -normalize(cross(dpdx, dpdy));
            break;
        }
        case 1:
        {
            posOS = poiMesh.localPos / poiTriplanarData.objScale;
            posWS = poiMesh.worldPos / poiTriplanarData.objScale;
            normalWS = normalize(poiMesh.objNormal);
            break;
        }
    }

    float3 axisSign = normalWS < 0 ? -1 : 1;

    poiMesh.uv[0] = float2(posOS.z * axisSign.x, posOS.y) + 0.5;
    poiMesh2.uv[0] = float2(posOS.x * axisSign.y, posOS.z) + 0.5;
    poiMesh3.uv[0] = float2(posOS.x * -axisSign.z, posOS.y) + 0.5;

    poiMesh.objNormal = normalWS;
    poiMesh.localPos = posOS;
    poiMesh.worldPos = posWS;

    poiMesh2.objNormal = poiMesh3.objNormal = poiMesh.objNormal;
    poiMesh2.localPos = poiMesh3.localPos = poiMesh.localPos;
    poiMesh2.worldPos = poiMesh3.worldPos = poiMesh.worldPos;

    float3 triblend;
    switch ((int)_TriplanarBlendType)
    {
        default:
        case 3: // Normal blend
        {
            triblend = abs(normalWS);
            triblend = max(triblend - _TriplanarBlendSharpeness, 0);
            triblend /= dot(triblend, float3(1,1,1));
            break;
        }
        case 1: // GPU Gems 3
        {
            triblend = saturate(pow(abs(normalWS), 6));
            triblend /= max(dot(triblend, 1..xxx), 0.0001);
            break;
        }
        case 2: // Asymmetric
        {
            triblend = 0;
            // Blend for sides only
            float2 xzBlend = abs(normalize(normalWS.xz));
            triblend.xz = max(0, xzBlend - 0.67);
            triblend.xz /= max(0.00001, dot(triblend.xz, float2(1,1)));
            // Blend for top
            triblend.y = saturate((abs(normalWS.y) - 0.675) * 80.0);
            triblend.xz *= (1 - triblend.y);
            break;
        }
    }

    half mask = 1;
    #if defined(PROP_TRIPLANARMASK) || !defined(OPTIMIZER_ENABLED)
        half maskX = POI2D_SAMPLER_PAN(_TriplanarMask, _MainTex, poiUV(poiMesh.uv[_TriplanarMaskUV], _TriplanarMask_ST), _TriplanarMaskPan)[(int)_TriplanarMaskChannel];
        half maskY = POI2D_SAMPLER_PAN(_TriplanarMask, _MainTex, poiUV(poiMesh2.uv[_TriplanarMaskUV], _TriplanarMask_ST), _TriplanarMaskPan)[(int)_TriplanarMaskChannel];
        half maskZ = POI2D_SAMPLER_PAN(_TriplanarMask, _MainTex, poiUV(poiMesh3.uv[_TriplanarMaskUV], _TriplanarMask_ST), _TriplanarMaskPan)[(int)_TriplanarMaskChannel];
        mask = maskX * triblend.x + maskY * triblend.y + maskZ * triblend.z;
        mask = (_TriplanarMaskInvert > 0.5) ? 1 - mask : mask;
        mask *= _TriplanarMaskStrength;
    #endif

    poiTriplanarData.triblend = triblend;
    poiTriplanarData.distFade = distFade;
    poiTriplanarData.mask = mask;
}

void TriplanarProjectionTangents(in PoiTriplanarData poiTriplanarData, inout PoiMesh poiMesh, inout PoiMesh poiMesh2, inout PoiMesh poiMesh3)
{
    if (_TriplanarMode == 0 && !poiTriplanarData.depthAvailable) return;
    
    float3 normalWS = poiMesh.objNormal;

    float3 triblend = poiTriplanarData.triblend;
    half mask = poiTriplanarData.mask;

    float3 tnormalX = poiMesh.tangentSpaceNormal;
    float3 tnormalY = poiMesh2.tangentSpaceNormal;
    float3 tnormalZ = poiMesh3.tangentSpaceNormal;

    float3 axisSign = normalWS < 0 ? -1 : 1;

    tnormalX.x *= axisSign.x;
    tnormalY.x *= axisSign.y;
    tnormalZ.x *= -axisSign.z;

    float3 normalX = float3(0.0, tnormalX.yx);
    float3 normalY = float3(tnormalY.x, 0.0, tnormalY.y);
    float3 normalZ = float3(tnormalZ.xy, 0.0);

    float3 blendedWS = normalize(
        normalX.xyz * triblend.x +
        normalY.xyz * triblend.y +
        normalZ.xyz * triblend.z +
        normalWS
    );

    blendedWS = _TriplanarMode == 1 ? PoiObjectToWorldNormal(blendedWS) : blendedWS;

    float3 blendedTS = float3(
        dot(blendedWS, poiMesh.tangent[0]),
        dot(blendedWS, poiMesh.binormal[0]),
        dot(blendedWS, poiMesh.normals[0])
    );

    poiMesh.tangentSpaceNormal = lerp(poiMesh.tangentSpaceNormal, blendedTS, mask);
    poiMesh2.tangentSpaceNormal = poiMesh3.tangentSpaceNormal = poiMesh.tangentSpaceNormal;
}

void TriplanarProjectionNormals(in PoiTriplanarData poiTriplanarData, inout PoiMesh poiMesh, inout PoiMesh poiMesh2, inout PoiMesh poiMesh3)
{
    if (_TriplanarMode == 0 && !poiTriplanarData.depthAvailable) return;

    if (_TriplanarMode == 0)
    {
        float3 normalWS = normalize(poiMesh.objNormal);
        float3 axisSign = normalWS < 0 ? -1 : 1;
        float3 triblend = poiTriplanarData.triblend;

        float3 triBinormal = float3(0, 1, 0) * (triblend.x + triblend.z) + float3(0, 0, 1) * triblend.y;
        triBinormal -= normalWS * dot(triBinormal, normalWS);
        if (dot(triBinormal, triBinormal) < 0.0001)
        {
            triBinormal = abs(normalWS.y) < 0.999 ? float3(0, 1, 0) : float3(0, 0, 1);
            triBinormal -= normalWS * dot(triBinormal, normalWS);
        }

        poiMesh.normals[0] = normalWS;
        poiMesh.binormal[0] = normalize(triBinormal);
        poiMesh.tangent[0] = normalize(cross(poiMesh.binormal[0], -poiMesh.normals[0]));

        poiMesh.binormal[1] = poiMesh.binormal[0] - poiMesh.normals[1] * dot(poiMesh.binormal[0], poiMesh.normals[1]);
        if (dot(poiMesh.binormal[1], poiMesh.binormal[1]) < 0.0001)
        {
            poiMesh.binormal[1] = poiMesh.binormal[0];
        }
        poiMesh.binormal[1] = normalize(poiMesh.binormal[1]);
        poiMesh.tangent[1] = normalize(cross(poiMesh.binormal[1], -poiMesh.normals[1]));
    }

    poiMesh2.normals[0] = poiMesh3.normals[0] = poiMesh.normals[0];
    poiMesh2.normals[1] = poiMesh3.normals[1] = poiMesh.normals[1];
    poiMesh2.tangent[0] = poiMesh3.tangent[0] = poiMesh.tangent[0];
    poiMesh2.tangent[1] = poiMesh3.tangent[1] = poiMesh.tangent[1];
    poiMesh2.binormal[0] = poiMesh3.binormal[0] = poiMesh.binormal[0];
    poiMesh2.binormal[1] = poiMesh3.binormal[1] = poiMesh.binormal[1];
}

void TriplanarProjectionPreShadows(inout PoiTriplanarData poiTriplanarData, inout PoiFragData poiFragData, inout PoiFragData poiFragData2, inout PoiFragData poiFragData3, inout PoiMesh poiMesh, inout PoiMesh poiMesh2, inout PoiMesh poiMesh3, in PoiCam poiCam)
{
    if (_TriplanarMode == 0 && !poiTriplanarData.depthAvailable) return;

    float3 triblend = poiTriplanarData.triblend;
    half mask = poiTriplanarData.mask;

    float4 colX = float4(poiFragData.baseColor, poiFragData.alpha);
    float4 colY = float4(poiFragData2.baseColor, poiFragData2.alpha);
    float4 colZ = float4(poiFragData3.baseColor, poiFragData3.alpha);
    float4 col = colX * triblend.x + colY * triblend.y + colZ * triblend.z;

    col.a *= poiTriplanarData.distFade * mask;

    poiTriplanarData.prevColor = float4(poiFragData.baseColor, poiFragData.alpha);

    poiFragData.baseColor = lerp(poiFragData.baseColor, col.rgb, mask);
    poiFragData.alpha = col.a;
}

