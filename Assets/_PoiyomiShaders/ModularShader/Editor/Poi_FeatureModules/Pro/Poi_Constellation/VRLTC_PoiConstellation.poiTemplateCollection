#T#PoiConstellationFunctions
//ifex _ConstellationEnable==0
#ifdef POI_CONSTELLATION
    float PoiN21(float2 p)
    {
        float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.x + p3.y) * p3.z);
    }

    float2 PoiN22(float2 p)
    {
        float n = PoiN21(p);
        return float2(n, PoiN21(p+n));
    }

    half3 PoiGetStarColor(float2 cellId, float rand1, float hueShift, half3 themeHSV, bool useThemeColor)
    {
        float rand2 = PoiN21(cellId + 17.3);
        float rand3 = PoiN21(cellId + 41.7);

        if(useThemeColor)
        {
            half3 jittered = themeHSV;
            jittered.x = frac(jittered.x + (rand1 - 0.5) * 0.1); // Slight hue variation
            jittered.y = saturate(jittered.y * lerp(0.8, 1.2, rand2)); // Slight saturation variation
            jittered.z = saturate(jittered.z * lerp(0.8, 1.2, rand3)); // Slight value variation
            return HSVtoRGB(jittered);
        }
        
        half3 hsv;
        hsv.x = frac(rand1 + hueShift);
        hsv.y = lerp(_ConstellationSaturationRange.x, _ConstellationSaturationRange.y, rand2);
        hsv.z = lerp(_ConstellationValueRange.x, _ConstellationValueRange.y, rand3);
        
        return HSVtoRGB(hsv);
    }

    float PoiDistLine(float2 p, float2 a, float2 b)
    {
        float2 pa = p-a;
        float2 ba = b-a;
        float baLengthSq = dot(ba, ba);
        float t = clamp(dot(pa, ba) / max(baLengthSq, 1e-8), 0.0, 1.0);
        return length(pa - ba * t);
    }

    void PoiComputeLineThickness(float thicknessMod, out float baseThickness, out float minThickness)
    {
        float finalThickness = saturate(_ConstellationLineThickness + thicknessMod);
        baseThickness = lerp(0.005, 0.05, finalThickness);
        minThickness = lerp(baseThickness, baseThickness * 0.3, _ConstellationLineThicknessVariation);
    }

    float PoiLine(float2 p, float2 a, float2 b, float baseThickness, float minThickness)
    {
        float2 pa = p-a;
        float2 ba = b-a;
        float baLengthSq = dot(ba, ba);
        float t = clamp(dot(pa, ba) / max(baLengthSq, 1e-8), 0.0, 1.0);
        float d = length(pa - ba * t);
        float lineLength = sqrt(baLengthSq);
        float centerThinness = 4.0 * t * (1.0 - t);
        float thickness = lerp(minThickness, baseThickness, 1.0 - centerThinness);
        
        float lineFade = 1.0 - smoothstep(0.0, thickness, d);
        float lengthFade = smoothstep(1.2, 0.05, lineLength);
        
        return lineFade * lengthFade;
    }

    half4 PoiLineColored(float2 p, float2 a, float2 b, half3 colorA, half3 colorB, float baseThickness, float minThickness)
    {
        float2 pa = p-a;
        float2 ba = b-a;
        float baLengthSq = dot(ba, ba);
        float t = clamp(dot(pa, ba) / max(baLengthSq, 1e-8), 0.0, 1.0);
        float d = length(pa - ba * t);
        float lineLength = sqrt(baLengthSq);
        float centerThinness = 4.0 * t * (1.0 - t);
        float thickness = lerp(minThickness, baseThickness, 1.0 - centerThinness);
        
        float lineFade = 1.0 - smoothstep(0.0, thickness, d);
        float lengthFade = smoothstep(1.2, 0.05, lineLength);
        
        half intensity = lineFade * lengthFade;
        half3 blendedColor = lerp(colorA, colorB, t);
        
        return float4(blendedColor, intensity);
    }

    float2 PoiGetPos(float2 cellId, float2 off, float wrappedTime, out float cellHash)
    {
        cellHash = PoiN21(cellId);
        float2 n = float2(cellHash, PoiN21(cellId + cellHash)) * wrappedTime;
        return off + sin(n) * _ConstellationStarMovement;
    }

    float PoiLayer(float2 uv, float time, float sizeMod, float brightnessMod, float twinkleMod, float movementMod, float lineThicknessMod, float lineBrightnessMod)
    {
        time = fmod(time, UNITY_TWO_PI * 2048.0);

        float2 gv = frac(uv) - 0.5;
        float2 id = floor(uv);
        float lines = 0.0;
        half sparkles = 0.0;

        float movementTime = fmod(time * _ConstellationStarSpeedMultiplier + movementMod, UNITY_TWO_PI * 2048.0);
        float unusedHash;
        float2 center = PoiGetPos(id, float2(0.0, 0.0), movementTime, unusedHash);
        float2 p1 = 0.0, p3 = 0.0, p5 = 0.0, p7 = 0.0;

        float t = time * _ConstellationTwinkleSpeed + twinkleMod;
        float starSize = saturate(_ConstellationStarSize + sizeMod);
        half starBrightness = max(0, _ConstellationStarBrightness + brightnessMod);
        float sizeScale = (1-starSize*0.75);

        float baseThickness, minThickness;
        PoiComputeLineThickness(lineThicknessMod, baseThickness, minThickness);

        int i = 0;
        for(float y=-1.0;y<=1.0;y++){
            for(float x=-1.0;x<=1.0;x++){
                float2 off = float2(x, y);
                float2 p = center;
                if(i != 4)
                {
                    p = PoiGetPos(id + off, off, movementTime, unusedHash);
                    lines += PoiLine(gv, center, p, baseThickness, minThickness);
                }

                if(i == 1) p1 = p;
                else if(i == 3) p3 = p;
                else if(i == 5) p5 = p;
                else if(i == 7) p7 = p;

                float2 vec = (p - gv) * 30.0 * sizeScale;
                half sparkle = min(1.0/max(dot(vec, vec), 0.01), 5.0);
                sparkles += sparkle*(sin(t+frac(p.x)*10.0)*0.5 + 0.5);
                i++;
            }
        }
        
        lines += PoiLine(gv, p1, p3, baseThickness, minThickness);
        lines += PoiLine(gv, p1, p5, baseThickness, minThickness);
        lines += PoiLine(gv, p3, p7, baseThickness, minThickness);
        lines += PoiLine(gv, p5, p7, baseThickness, minThickness);
        
        half finalLineBrightness = max(0, _ConstellationLineBrightness + lineBrightnessMod);
        lines = min(lines * finalLineBrightness, 1.0);
        sparkles = min(sparkles * starBrightness / 4.0, 1.0);
        
        return min(lines + sparkles, 1.0);
    }

    half4 PoiLayerColored(float2 uv, float time, float sizeMod, float brightnessMod, float twinkleMod, float movementMod, float lineThicknessMod, float lineBrightnessMod, float hueShift, half3 themeHSV, bool useThemeColor)
    {
        time = fmod(time, UNITY_TWO_PI * 2048.0);

        float2 gv = frac(uv) - 0.5;
        float2 id = floor(uv);
        half3 lineColor = half3(0, 0, 0);
        half lineIntensity = 0.0;
        half3 sparkleColor = half3(0, 0, 0);
        half sparkleIntensity = 0.0;

        float movementTime = fmod(time * _ConstellationStarSpeedMultiplier + movementMod, UNITY_TWO_PI * 2048.0);
        float centerHash;
        float2 center = PoiGetPos(id, float2(0.0, 0.0), movementTime, centerHash);
        half3 centerColor = PoiGetStarColor(id, centerHash, hueShift, themeHSV, useThemeColor);

        float t = time * _ConstellationTwinkleSpeed + twinkleMod;
        float centerTwinkle = sin(t+frac(center.x)*10.0)*0.5 + 0.5;
        float starSize = saturate(_ConstellationStarSize + sizeMod);
        half starBrightness = max(0, _ConstellationStarBrightness + brightnessMod);
        float sizeScale = (1-starSize*0.75);

        float baseThickness, minThickness;
        PoiComputeLineThickness(lineThicknessMod, baseThickness, minThickness);

        float2 p1 = 0.0, p3 = 0.0, p5 = 0.0, p7 = 0.0;
        half3 c1 = 0.0, c3 = 0.0, c5 = 0.0, c7 = 0.0;
        half tw1 = 0.0, tw3 = 0.0, tw5 = 0.0, tw7 = 0.0;
        int i = 0;
        for(float y=-1.0;y<=1.0;y++){
            for(float x=-1.0;x<=1.0;x++){
                float2 off = float2(x, y);
                float2 p = center;
                half3 starColor = centerColor;
                half twinkle = centerTwinkle;
                if(i != 4)
                {
                    float cellHash;
                    float2 cellId = id + off;
                    p = PoiGetPos(cellId, off, movementTime, cellHash);
                    starColor = PoiGetStarColor(cellId, cellHash, hueShift, themeHSV, useThemeColor);
                    twinkle = sin(t+frac(p.x)*10.0)*0.5 + 0.5;

                    half lineTwinkle = (centerTwinkle + twinkle) * 0.5;
                    half4 lineResult = PoiLineColored(gv, center, p, centerColor, starColor, baseThickness, minThickness);
                    lineColor += lineResult.rgb * lineResult.a * lineTwinkle;
                    lineIntensity += lineResult.a * lineTwinkle;
                }

                if(i == 1) { p1 = p; c1 = starColor; tw1 = twinkle; }
                else if(i == 3) { p3 = p; c3 = starColor; tw3 = twinkle; }
                else if(i == 5) { p5 = p; c5 = starColor; tw5 = twinkle; }
                else if(i == 7) { p7 = p; c7 = starColor; tw7 = twinkle; }

                float2 vec = (p - gv) * 30.0 * sizeScale;
                half sparkle = min(1.0/max(dot(vec, vec), 0.01), 5.0) * twinkle;

                sparkleColor += starColor * sparkle;
                sparkleIntensity += sparkle;
                i++;
            }
        }

        // The four cross-neighbor paths reuse the values retained by the combined pass.
        half twinkle13 = (tw1 + tw3) * 0.5;
        half twinkle15 = (tw1 + tw5) * 0.5;
        half twinkle37 = (tw3 + tw7) * 0.5;
        half twinkle57 = (tw5 + tw7) * 0.5;

        half4 lineResult1 = PoiLineColored(gv, p1, p3, c1, c3, baseThickness, minThickness);
        half4 lineResult2 = PoiLineColored(gv, p1, p5, c1, c5, baseThickness, minThickness);
        half4 lineResult3 = PoiLineColored(gv, p3, p7, c3, c7, baseThickness, minThickness);
        half4 lineResult4 = PoiLineColored(gv, p5, p7, c5, c7, baseThickness, minThickness);
        
        lineColor += lineResult1.rgb * lineResult1.a * twinkle13;
        lineColor += lineResult2.rgb * lineResult2.a * twinkle15;
        lineColor += lineResult3.rgb * lineResult3.a * twinkle37;
        lineColor += lineResult4.rgb * lineResult4.a * twinkle57;
        lineIntensity += lineResult1.a * twinkle13 + lineResult2.a * twinkle15 + lineResult3.a * twinkle37 + lineResult4.a * twinkle57;
        
        half finalLineBrightness = max(0, _ConstellationLineBrightness + lineBrightnessMod);
        lineIntensity = min(lineIntensity * finalLineBrightness, 1.0);
        sparkleIntensity = min(sparkleIntensity * starBrightness / 4.0, 1.0);
        
        half totalIntensity = min(lineIntensity + sparkleIntensity, 1.0);
        half3 finalColor = half3(0, 0, 0);
        if(totalIntensity > 0.001)
        {
            finalColor = (lineColor * finalLineBrightness + sparkleColor * starBrightness / 4.0) / (lineIntensity + sparkleIntensity + 0.001);
        }
        
        return float4(finalColor, totalIntensity);
    }

    void applyConstellation(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
    {
        if(_ConstellationEnable < 0.5) return;

        half4 constellationColorFinal = _ConstellationColor;
        if(_ConstellationColorThemeIndex > 0)
        {
            constellationColorFinal.rgb = poiThemeColor(poiMods, _ConstellationColor.rgb, _ConstellationColorThemeIndex);
        }

        half mask = 1.0;
        #if defined(PROP_CONSTELLATIONMASK) || !defined(OPTIMIZER_ENABLED)
            mask = POI2D_SAMPLER_PAN(_ConstellationMask, _MainTex, poiUV(poiMesh.uv[_ConstellationMaskUV], _ConstellationMask_ST), _ConstellationMaskPan).r;
        #endif
        if(_ConstellationMaskInvert >= 0.5)
        {
            mask = 1.0 - mask;
        }
        
        if(_ConstellationMaskGlobalMask > 0)
        {
            mask = maskBlend(mask, poiMods.globalMask[_ConstellationMaskGlobalMask - 1], _ConstellationMaskGlobalMaskBlendType);
        }
        
        if(mask == 0.0) 
        {
            return;
        }

        half alEmissionMod = 0;
        half alBrightnessMod = 0;
        float alSizeMod = 0;
        float alLineThicknessMod = 0;
        half alLineBrightnessMod = 0;
        float alTwinkleMod = 0;
        float alMovementMod = 0;
        float alHueShift = 0;
        half3 alThemeColor = half3(1, 1, 1);
        bool alUseThemeColor = false;
        
        #ifdef POI_AUDIOLINK
            if(poiMods.audioLinkAvailable && _ConstellationAudioLinkEnabled >= 0.5)
            {
                // Intensity-reactive modifiers
                alEmissionMod = lerp(_ConstellationALEmissionMod.x, _ConstellationALEmissionMod.y, poiMods.audioLink[_ConstellationALEmissionBand]);
                alBrightnessMod = lerp(_ConstellationALBrightnessMod.x, _ConstellationALBrightnessMod.y, poiMods.audioLink[_ConstellationALBrightnessBand]);
                alSizeMod = lerp(_ConstellationALSizeMod.x, _ConstellationALSizeMod.y, poiMods.audioLink[_ConstellationALSizeBand]);
                alLineThicknessMod = lerp(_ConstellationALLineThicknessMod.x, _ConstellationALLineThicknessMod.y, poiMods.audioLink[_ConstellationALLineThicknessBand]);
                alLineBrightnessMod = lerp(_ConstellationALLineBrightnessMod.x, _ConstellationALLineBrightnessMod.y, poiMods.audioLink[_ConstellationALLineBrightnessBand]);
                
                // Chronotensity-based modifiers
                alTwinkleMod = AudioLinkGetChronoTime(_ConstellationALTwinkleType, _ConstellationALTwinkleBand) * _ConstellationALTwinkleSpeed;
                alMovementMod = AudioLinkGetChronoTime(_ConstellationALMovementType, _ConstellationALMovementBand) * _ConstellationALMovementSpeed;
                
                // Color modifiers (only used when random colors enabled)
                if(_ConstellationRandomColors >= 0.5)
                {
                    alHueShift = AudioLinkGetChronoTime(_ConstellationALHueShiftType, _ConstellationALHueShiftBand) * _ConstellationALHueShiftSpeed;
                    if(_ConstellationALThemeColor > 0)
                    {
                        alUseThemeColor = true;
                        alThemeColor = AudioLinkData(ALPASS_THEME_COLOR0 + uint2(_ConstellationALThemeColor - 1, 0)).rgb;
                    }
                }
            }
        #endif

        float2 constellationUV = poiMesh.uv[_ConstellationUV].xy;

        float2 uv = constellationUV - _ConstellationCenter.xy;
        uv *= _ConstellationDensity;
        
        float t = POI_TIME.y * _ConstellationPanSpeed.z / _ConstellationDensity + _ConstellationOffset.z;
        
        uv += (_ConstellationPanSpeed.xy / _ConstellationDensity) * POI_TIME.y + _ConstellationOffset.xy;
        
        half constellationMask = 0.0;
        half3 constellationColor = half3(0, 0, 0);

        half3 alThemeHSV = RGBtoHSV(alThemeColor);

        UNITY_BRANCH
        if(_ConstellationRandomColors >= 0.5)
        {
            half3 accumulatedColor = half3(0, 0, 0);
            half accumulatedIntensity = 0.0;
            
            [unroll]
            for (int layer = 0; layer < 4; ++layer)
            {
                float i = layer * 0.25;
                float z = frac(i+t);
                float size = lerp(10.0, 0.5, z);
                // Fade based on layer depth: z=0 is back (use min), z=1 is front (use max)
                half fade = lerp(_ConstellationLayerFade.x, _ConstellationLayerFade.y, z);
                
                half4 layerResult = PoiLayerColored(uv * size + i*24.0, POI_TIME.y, alSizeMod, alBrightnessMod, alTwinkleMod, alMovementMod, alLineThicknessMod, alLineBrightnessMod, alHueShift, alThemeHSV, alUseThemeColor);
                accumulatedColor += layerResult.rgb * layerResult.a * fade;
                accumulatedIntensity += layerResult.a * fade;
            }
            
            constellationMask = min(accumulatedIntensity, 1.0) * mask;
            if(accumulatedIntensity > 0.001)
            {
                constellationColor = accumulatedColor / accumulatedIntensity * constellationMask;
            }
        }
        else
        {
            half m = 0.0;
            [unroll]
            for (int layer = 0; layer < 4; ++layer)
            {
                float i = layer * 0.25;
                float z = frac(i+t);
                float size = lerp(10.0, 0.5, z);
                // Fade based on layer depth: z=0 is back (use min), z=1 is front (use max)
                half fade = lerp(_ConstellationLayerFade.x, _ConstellationLayerFade.y, z);
                
                m += PoiLayer(uv * size + i*24.0, POI_TIME.y, alSizeMod, alBrightnessMod, alTwinkleMod, alMovementMod, alLineThicknessMod, alLineBrightnessMod) * fade;
            }
            
            m = min(m, 1.0);
            m *= mask;
            constellationMask = m;
            constellationColor = m * constellationColorFinal.rgb;
        }
        
        #ifdef POI_AUDIOLINK
            UNITY_BRANCH
            if(_ConstellationAudioLinkEnabled >= 0.5 && _ConstellationALColorOverrideEnabled >= 0.5 && poiMods.audioLinkAvailable)
            {
                half alColorOverrideIntensity = poiMods.audioLink[_ConstellationALColorOverrideBand];
                half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, _ConstellationALColorOverrideRamp);
                if(alColorOverrideBlend > 0)
                {
                    half3 alOverrideColor = _ConstellationALColorOverride.rgb;
                    if(_ConstellationALColorOverrideThemeIndex > 0)
                    {
                        alOverrideColor = poiThemeColor(poiMods, alOverrideColor, _ConstellationALColorOverrideThemeIndex);
                    }
                    constellationColor = lerp(constellationColor, alOverrideColor * constellationMask, alColorOverrideBlend);
                }
            }
        #endif

        if(_ConstellationBlendMode == 0)
        {
            poiFragData.baseColor = lerp(poiFragData.baseColor, constellationColor, constellationMask);
        }
        else if(_ConstellationBlendMode == 1)
        {
            poiFragData.baseColor = lerp(poiFragData.baseColor, poiFragData.baseColor * constellationColor, constellationMask);
        }
        else
        {
            poiFragData.baseColor += constellationColor * constellationMask;
        }
        
        half finalEmissionStrength = _ConstellationEmissionStrength + alEmissionMod;
        poiFragData.emission += constellationColor * constellationMask * finalEmissionStrength;
        
        if(_ConstellationApplyGlobalMaskIndex > 0)
        {
            applyToGlobalMask(poiMods, _ConstellationApplyGlobalMaskIndex - 1, _ConstellationApplyGlobalMaskBlendType, constellationMask);
        }
    }
#endif
//endex

#T#PoiConstellationFunctionCall
//ifex _ConstellationEnable==0
#ifdef POI_CONSTELLATION
    applyConstellation(poiFragData, poiMesh, poiMods);
    #K#CONSTELLATION_HOOK
#endif
//endex
