#T#PoiFurVertexOutVariable
// xyz: per-shell settings written by the geometry stage.
// w:   renderer scale, captured in the vertex stage.
float4 furSettings : TEXCOORD18;

#T#PoiFurVertexMod
o.furSettings.w = length(mul((float3x3)unity_ObjectToWorld, v.normal));

#T#PoiFurGeom
#if !defined(OPTIMIZER_ENABLED)
	[poi_instance(32)]
#else
	[poi_instance(_FurLayerCount + 1)]
#endif
[poi_maxvertexcount(3)]
void geom(triangle VertexOut input[3], inout TriangleStream<VertexOut> outStream, uint InstanceID : SV_GSInstanceID)
{
	UNITY_SETUP_INSTANCE_ID(input[0]);
	UNITY_SETUP_INSTANCE_ID(input[1]);
	UNITY_SETUP_INSTANCE_ID(input[2]);
	POI_INITIALIZE_VERTEX_OUTPUT_STEREO(input[0]);
	POI_INITIALIZE_VERTEX_OUTPUT_STEREO(input[1]);
	POI_INITIALIZE_VERTEX_OUTPUT_STEREO(input[2]);

	#K#GEOMETRY_INPUT_MODS

	#if !defined(POI_PASS_OUTLINE) && !defined(POI_PASS_MOTION_VECTORS)
		float furScale = input[0].furSettings.w;
		float layerCountF;
		float configuredLayerCount = clamp((float)_FurLayerCount, 1.0, 31.0);
		#if defined(POI_DEVICE_QUEST)
			layerCountF = 1;
		#else
			float3 objectPos = unity_ObjectToWorld._m03_m13_m23;
			layerCountF = max(1, configuredLayerCount * (1 - smoothstep(_FurMinDistance * furScale, _FurMaxDistance * furScale, distance(objectPos, getCameraPosition()))));
		#endif
		uint layerCount = (uint)ceil(layerCountF);
		if (InstanceID > layerCount) return;
		float4 furSettings = 0;
		furSettings.x = InstanceID > 0;
		// Keep fixed shell height
		furSettings.y = InstanceID / configuredLayerCount;

		furSettings.y *= furSettings.x;
		// Fade the outermost shell by the fractional layer count
		furSettings.z = (InstanceID == layerCount) ? saturate(layerCountF - (float)(layerCount - 1)) : 1.0;
		VertexOut o[3];
		float furLen = furSettings.y * _FurLength;
		float gravSign = -sign(_FurGravityStrength);
		[unroll(3)]
		for (int i = 0; i < 3; i++)
		{
			VertexOut t = input[i];
			// Read before furSettings.xyz is overwritten below.
			float furLenScaled = furLen * t.furSettings.w;
			float3 normal = t.normal;
			if (_FurUseVertexColorNormals >= 0.5)
			{
				float3 vectorTS = t.vertexColor.rgb * 2.0 - 1.0;

				float3 binormal = cross(t.normal, t.tangent) * (t.tangent.w * unity_WorldTransformParams.w);
				normal = vectorTS.x * t.tangent.xyz + vectorTS.y * binormal.xyz + vectorTS.z * normal;
			}
			float furGravity = furLenScaled * _FurGravityStrength;
			float3 furGravityOffset = float3(0, -furGravity, 0) * smoothstep(-0.5, 1, gravSign * normal.y * 0.5 + 0.5);
			t.furSettings = furSettings;
			float3 offset = furGravityOffset + furLenScaled * normal;
			t.worldPos.xyz += offset;
			t.localPos.xyz += mul((float3x3)unity_WorldToObject, offset);
			o[i] = t;
		}
		float3 faceNormal = mul(unity_ObjectToWorld, float4(cross(o[0].localPos.xyz - o[1].localPos.xyz, o[0].localPos.xyz - o[2].localPos.xyz), 0)).xyz;
		bool isBackFacing = dot(PoiWorldSpaceViewDir((o[0].worldPos.xyz + o[1].worldPos.xyz + o[2].worldPos.xyz) * 0.33333333), faceNormal) < 0.0;
		if (InstanceID > 0 && isBackFacing) return;
		[unroll(3)]
		for (int j = 0; j < 3; j++)
		{
			o[j].pos = PoiWorldToClipPos(o[j].worldPos.xyz);
			outStream.Append(o[j]);
		}
	#else
		[unroll(3)]
		for (int j = 0; j < 3; j++)
		{
			input[j].pos = PoiWorldToClipPos(input[j].worldPos.xyz);
			outStream.Append(input[j]);
		}
	#endif
}

#T#PoiFurFragFunctions
void applyFur(in float3 furSettings, inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
{
	#if defined(PROP_FURMASK) || !defined(OPTIMIZER_ENABLED)
		half furMask = POI2D_SAMPLER_PAN(_FurMask, _MainTex, poiUV(poiMesh.uv[_FurMaskUV], _FurMask_ST), _FurMaskPan).x;
	#else
		half furMask = 1;
	#endif
	#if defined(PROP_FURHEIGHTMAP) || !defined(OPTIMIZER_ENABLED)
		float furHeightMap = POI2D_SAMPLER_PAN(_FurHeightMap, _MainTex, poiUV(poiMesh.uv[_FurHeightMapUV], _FurHeightMap_ST), _FurHeightMapPan).x;
		furHeightMap = saturate(remap(furHeightMap, 0, _FurHeightMapMinMax.y, _FurHeightMapMinMax.x, 1));
	#else
		float furHeightMap = 1;
	#endif
	float furAOProgress = remapClamped(_FurAOMinMax.x, _FurAOMinMax.y, furHeightMap);
	float ao = lerp(1, furAOProgress, _FurAO * furMask);
	#if defined(PROP_FURTEXTURE) || !defined(OPTIMIZER_ENABLED)
		float4 furTexture = POI2D_SAMPLER_PAN(_FurTexture, _MainTex, poiUV(poiMesh.uv[_FurTextureUV], _FurTexture_ST), _FurTexturePan);
	#else
		float4 furTexture = float4(1, 1, 1, 1);
	#endif
	furTexture.rgb *= poiThemeColor(poiMods, _FurColor.rgb, _FurColorThemeIndex);

	if (_FurHueShiftEnabled >= 0.5)
	{
		furTexture.rgb = hueShift(furTexture.rgb, _FurHueShift + POI_TIME.x * _FurHueShiftSpeed, _FurHueShiftColorSpace, _FurHueSelectOrShift);
	}

	furTexture.rgb *= ao;
	if (furSettings.x)
	{
		poiFragData.baseColor = furTexture.rgb;
		// Distance LOD fade for the outermost shell (see geometry stage).
		poiFragData.alpha *= furSettings.z;
		float furTip = furSettings.y + _FurTipTaper * furSettings.y * furSettings.y;
		if (_AlphaToCoverage >= 0.5)
		{
			poiFragData.alpha = min(poiFragData.alpha, min(saturate(furHeightMap - furTip), saturate(furMask - furTip)));
			if (_AlphaSharpenedA2C < 0.5)
			{
				poiFragData.alpha = saturate((poiFragData.alpha) / max(fwidth(poiFragData.alpha), 0.0001));
			}
		}
		else
		{
			clip(furHeightMap - furTip);
			clip(furMask - furTip);
		}
	}
	else
	{
		poiFragData.baseColor = lerp(poiFragData.baseColor, furTexture.rgb, furMask * _FurTextureApplyToSkin);
	}
}

#T#PoiFurFragFunctionCalls
#if !defined(POI_PASS_OUTLINE) && !defined(POI_PASS_MOTION_VECTORS)
	applyFur(i.furSettings.xyz, poiFragData, poiMesh, poiMods);
#endif

