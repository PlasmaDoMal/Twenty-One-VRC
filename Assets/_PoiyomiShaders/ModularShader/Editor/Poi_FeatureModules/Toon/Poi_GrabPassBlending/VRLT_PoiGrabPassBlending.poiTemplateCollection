half4 grabpassBlur(float2 uv, float camDistance, half smoothness, half depthFade, half blurMask)
{
	half roughnessInfluence = lerp(1, 1 - smoothness, _GrabBlurUseSmoothness);
	float effectiveDistance = lerp(1, camDistance, _GrabBlurFalloff);
	float scale = WorldToScreenScale(_GrabBlurDistance * roughnessInfluence * depthFade * blurMask * 0.1, effectiveDistance);
	float2 aspectCorrect = GetScreenAspectCorrection();
	float sourceTexelRadius = abs(scale) * _PoiOpaqueTex_TexelSize.w;
	if (sourceTexelRadius < 1.0)
		return POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv);
	
	half4 color = 0;
	half totalWeight = 0;
	int quality = min((int)floor(_GrabBlurQuality), POI_GRAB_BLUR_MAX_QUALITY);
	int maxSamples = quality * quality;
	float blurPixelRadius = scale * _ScreenParams.y;
	int samples = min((int)clamp(ceil(UNITY_PI * blurPixelRadius * blurPixelRadius), 4.0, (float)maxSamples), POI_GRAB_BLUR_MAX_SAMPLES);

	switch (_GrabBlurPattern)
	{
		case 0: // Sunflower - Golden angle spiral
		{
			const float goldenAngle = 2.39996323;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float adjustedR = pow(r, _GrabBlurPower + 1);
				float2 offset = float2(cos(theta), sin(theta)) * adjustedR * scale * aspectCorrect;
				half weight = 1.0 - r * _GrabBlurPower;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv + offset) * weight;
				totalWeight += weight;
			}
			break;
		}
		case 1: // Gaussian - Spiral with gaussian weights
		{
			const float goldenAngle = 2.39996323;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float2 offset = float2(cos(theta), sin(theta)) * r * scale * aspectCorrect;
				half weight = exp(-r * r * (3.0 + _GrabBlurPower * 5.0));
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv + offset) * weight;
				totalWeight += weight;
			}
			break;
		}
		case 2: // Hexagonal Bokeh - 6-sided shape (point at bottom)
		{
			const float goldenAngle = 2.39996323;
			const float hexRotation = UNITY_PI / 6.0;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float2 dir = float2(cos(theta), sin(theta));
				float sectorAngle = atan2(dir.y, dir.x) + hexRotation;
				float angleInSector = fmod(abs(sectorAngle), UNITY_PI / 3.0) - UNITY_PI / 6.0;
				float hexScale = cos(UNITY_PI / 6.0) / cos(angleInSector);
				float2 offset = dir * r * hexScale * scale * aspectCorrect;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv + offset);
				totalWeight += 1.0;
			}
			break;
		}
		case 3: // Gaussian - baked progressive kernel
		{
			int sampleBudget = min(_GrabBlurQuality <= 4 ? 4 : (_GrabBlurQuality <= 8 ? 8 : (_GrabBlurQuality <= 16 ? 16 : 32)), POI_GRAB_BLUR_MAX_BAKED_SAMPLES);
			float coveredSamples = ceil(UNITY_PI * sourceTexelRadius * sourceTexelRadius);
			int bakedSamples = 4;
			if (sampleBudget >= 8 && coveredSamples > 4.0) bakedSamples = 8;
			if (sampleBudget >= 16 && coveredSamples > 8.0) bakedSamples = 16;
			if (sampleBudget >= 32 && coveredSamples > 16.0) bakedSamples = 32;
			bakedSamples = min(bakedSamples, POI_GRAB_BLUR_MAX_BAKED_SAMPLES);

			half2 bakedWeightSums = bakedSamples == 4 ? float2(1.71842691, 1.02028086) :
				(bakedSamples == 8 ? float2(2.89948330, 1.39562121) :
				(bakedSamples == 16 ? float2(5.30323938, 2.24210826) : float2(10.13189379, 3.98826393)));

			[loop]
			for (int i = 0; i < bakedSamples; i++)
			{
				half4 kernel = POI_GRAB_BLUR_GAUSSIAN_KERNEL[i];
				half weight = lerp(kernel.z, kernel.w, _GrabBlurPower);
				float2 offset = kernel.xy * scale * aspectCorrect;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv + offset) * weight;
			}
			totalWeight = lerp(bakedWeightSums.x, bakedWeightSums.y, _GrabBlurPower);
			break;
		}
		default:
			return POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, uv);
	}

	color /= max(totalWeight, EPSILON);
	return color;
}

float getGrabBlurDepthFade(float2 screenPos, float4 direction, float3 fragmentWorldPos)
{
	if (_GrabBlurUseDepth < 0.5) return 1;
	if (!DepthTextureExists()) return 1;
	
	float z = SampleScreenDepth(screenPos);
	
	float backgroundDepth = CorrectedLinearEyeDepth(z, direction.w);
	float3 backgroundWorldPos = direction.xyz * backgroundDepth + getCameraPosition(false);
	float depthDiff = distance(backgroundWorldPos, fragmentWorldPos);
	
	return lerp(_GrabBlurDepthRamp.x, _GrabBlurDepthRamp.y, smoothstep(_GrabBlurDepthRamp.z, _GrabBlurDepthRamp.w, depthDiff));
}

inline half4 Refraction(float indexOfRefraction, half chromaticAberration, float camDistance, float4 direction, in PoiMesh poiMesh, in PoiCam poiCam, in PoiMods poiMods, inout PoiLight poiLight, in PoiFragData poiFragData, half refractionMask, half blurMask)
{
	half4 refractionColor;
	float3 worldViewDir = normalize(PoiWorldSpaceViewDir(poiMesh.worldPos));
	float3 refractionOffset = (((indexOfRefraction - 1.0) * mul(UNITY_MATRIX_V, float4(poiMesh.normals[1], 0.0)).xyz) * (1.0 - dot(poiMesh.normals[1], worldViewDir)));
	float2 cameraRefraction = float2(refractionOffset.x, - (refractionOffset.y * _ProjectionParams.x)) * GetFOVScale() / max(camDistance, 1.0);
	cameraRefraction *= pow(saturate(1.0 - poiLight.nDotV), _RefractionFresnelPower);

	float2 bgRes = poiGetWidthAndHeight(_PoiOpaqueTex);
	float aspect = bgRes.y / bgRes.x;
	cameraRefraction.x *= aspect;
	cameraRefraction *= refractionMask;

	float2 refractedGrab = poiCam.screenUV + cameraRefraction;
	float depthFade = getGrabBlurDepthFade(refractedGrab, direction, poiMesh.worldPos);

	UNITY_BRANCH
	if (_RefractionChromaticAberration > 0)
	{
		half4 redAlpha = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, (poiCam.screenUV + cameraRefraction));
		half green = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, (poiCam.screenUV + (cameraRefraction * (1.0 - chromaticAberration)))).g;
		half blue = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, (poiCam.screenUV + (cameraRefraction * (1.0 + chromaticAberration)))).b;
		refractionColor = float4(redAlpha.r, green, blue, redAlpha.a);
	}
	else
	{
		#ifdef CHROMATIC_ABERRATION_LOW
			refractionColor = grabpassBlur(refractedGrab, camDistance, poiFragData.smoothness, depthFade, blurMask);
		#else
			refractionColor = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, refractedGrab);
		#endif
	}
	return refractionColor;
}

void applyGrabEffects(inout PoiFragData poiFragData, in PoiCam poiCam, in PoiMesh poiMesh, inout PoiLight poiLight, in PoiMods poiMods)
{
	half4 blendMask = 1;
	#if defined(PROP_GRABPASSBLENDMAP) || !defined(OPTIMIZER_ENABLED)
		if (_GrabPassMaskType == 0)
			blendMask = POI2D_SAMPLER_PAN(_GrabPassBlendMap, _MainTex, poiUV(poiMesh.uv[_GrabPassBlendMapUV], _GrabPassBlendMap_ST), _GrabPassBlendMapPan);
	#endif
	if (_GrabPassMaskType == 1) blendMask = poiMesh.vertexColor;

	half refractionMask = 1;
	half blurMask       = 1;
	half colorMask      = 1;
	half alphaMask      = 1;

	if (_GrabRefractionMaskChannel < 4) refractionMask = _GrabRefractionMaskInvert ? 1 - blendMask[min(_GrabRefractionMaskChannel, 3)] : blendMask[min(_GrabRefractionMaskChannel, 3)];
	if (_GrabBlurMaskChannel < 4)       blurMask       = _GrabBlurMaskInvert       ? 1 - blendMask[min(_GrabBlurMaskChannel, 3)]       : blendMask[min(_GrabBlurMaskChannel, 3)];
	if (_GrabColorMaskChannel < 4)      colorMask      = _GrabColorMaskInvert      ? 1 - blendMask[min(_GrabColorMaskChannel, 3)]      : blendMask[min(_GrabColorMaskChannel, 3)];
	if (_GrabAlphaMaskChannel < 4)      alphaMask      = _GrabAlphaMaskInvert      ? 1 - blendMask[min(_GrabAlphaMaskChannel, 3)]      : blendMask[min(_GrabAlphaMaskChannel, 3)];

	refractionMask = globalMaskBlend(refractionMask, _GrabRefractionGlobalMask, _GrabRefractionGlobalMaskBlendType, poiMods);
	blurMask       = globalMaskBlend(blurMask,       _GrabBlurGlobalMask,       _GrabBlurGlobalMaskBlendType,       poiMods);
	colorMask      = globalMaskBlend(colorMask,      _GrabColorGlobalMask,      _GrabColorGlobalMaskBlendType,      poiMods);
	alphaMask      = globalMaskBlend(alphaMask,      _GrabAlphaGlobalMask,      _GrabAlphaGlobalMaskBlendType,      poiMods);
	half blendFactor = lerp(0.0, (1 - poiFragData.alpha) * alphaMask, _GrabPassBlendFactor);

	if (_RefractionEnabled >= 0.5)
		poiLight.finalLighting = max(poiLight.finalLighting, EPSILON);

	#ifdef POI_PASS_ADD
		poiFragData.baseColor = poiBlend(_GrabSrcBlend, float4(poiFragData.baseColor, poiFragData.alpha), _GrabDstBlend, float4(0, 0, 0, 1), blendFactor).rgb;
		return;
	#endif

	float camDistance = poiCam.distanceToVert;
	
	float perspectiveDivide = 1.0f / poiCam.clipPos.w;
	float4 direction = poiCam.worldDirection * perspectiveDivide;
	
	half3 grabpassColor = 1;
	UNITY_BRANCH
	if (_RefractionEnabled >= 0.5)
	{
		grabpassColor = Refraction(_RefractionIndex, _RefractionChromaticAberration, camDistance, direction, poiMesh, poiCam, poiMods, poiLight, poiFragData, refractionMask, blurMask).rgb;
	}
	else
	{
		float depthFade = getGrabBlurDepthFade(poiCam.screenUV, direction, poiMesh.worldPos);
		#ifdef CHROMATIC_ABERRATION_LOW
			grabpassColor = grabpassBlur(poiCam.screenUV, camDistance, poiFragData.smoothness, depthFade, blurMask);
		#else
			grabpassColor = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiCam.screenUV).rgb;
		#endif
	}

	half3 tintedColor = (_GrabpassColor.rgb * grabpassColor * _GrabPassBrightness) + (_GrabPassAddBrightness * _GrabpassColor.rgb);

	UNITY_BRANCH
	if (_GrabPassHueShiftToggle >= 0.5)
	{
		tintedColor = hueShift(tintedColor, frac(_GrabPassHueShift + _GrabPassHueShiftSpeed * POI_TIME.x), _GrabPassHueShiftColorSpace, _GrabPassHueSelectOrShift);
	}
	grabpassColor = lerp(grabpassColor, tintedColor, colorMask);
	#ifdef POI_PASS_BASE
		poiFragData.baseColor = poiBlend(_GrabSrcBlend, float4(poiFragData.baseColor, poiFragData.alpha), _GrabDstBlend, float4(grabpassColor / poiLight.finalLighting, 1), blendFactor).rgb;
	#endif
}
//endex

